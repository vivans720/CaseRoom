# =========================
# DATABASE
# =========================

MONGODB_URI=

# =========================
# SERVER
# =========================

PORT=5000
NODE_ENV=development

# =========================
# JWT AUTH
# =========================

JWT_SECRET=
JWT_EXPIRES_IN=7d

# =========================
# CLOUDINARY
# =========================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=caseroom/attachments

# =========================
# EMAIL / BREVO
# =========================

BREVO_API_KEY=
EMAIL_FROM=

# =========================
# FILE UPLOAD
# =========================

MAX_FILE_SIZE_MB=16

# =========================
# LLM PROVIDER CONFIGURATION
# =========================

# Provider fallback order (comma-separated)
# Production: gemini,groq,cerebras,openrouter,mistral
# Development: gemini,groq,cerebras,openrouter,mistral,ollama
# Ollama is automatically excluded in production (NODE_ENV=production)
LLM_PROVIDER_ORDER=gemini,groq,cerebras,openrouter,mistral,ollama

LLM_PROVIDER_TIMEOUT_MS=30000
LLM_PROVIDER_MAX_RETRIES=1
LLM_PROVIDER_COOLDOWN_MS=60000

# Provider API Keys (providers without keys are skipped)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Provider Models (optional overrides)
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# MISTRAL_MODEL=mistral-small-latest

# Ollama (local development only — never used in production)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
